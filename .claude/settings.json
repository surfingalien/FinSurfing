{
  "permissions": {
    "ask": [
      "mcp__alpaca__place_stock_order",
      "mcp__alpaca__cancel_order_by_id",
      "mcp__alpaca__replace_order_by_id",
      "mcp__alpaca__close_position",
      "mcp__alpaca__update_account_config"
    ],
    "deny": [
      "mcp__alpaca__place_option_order",
      "mcp__alpaca__place_crypto_order",
      "mcp__alpaca__close_all_positions",
      "mcp__alpaca__cancel_all_orders",
      "mcp__alpaca__exercise_options_position",
      "mcp__alpaca__do_not_exercise_options_position"
    ]
  },
  "mcpServers": {
    "21st-magic": {
      "command": "npx",
      "args": [
        "-y",
        "@21st-dev/magic@latest"
      ],
      "env": {
        "API_KEY": "your-21st-dev-api-key-here"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "tool == \"Edit\" || tool == \"Write\"",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/pro-workflow/scripts/secret-scan.js\""
          }
        ],
        "description": "Scan for hardcoded secrets before any file write or edit"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "node \"$HOME/.claude/pro-workflow/scripts/pre-commit-check.js\""
          }
        ],
        "description": "Quality gate before git commits"
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/pro-workflow/scripts/learn-capture.js\""
          }
        ],
        "description": "Auto-capture [LEARN] blocks from responses into SQLite store"
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/pro-workflow/scripts/session-start.js\""
          }
        ],
        "description": "Load learned patterns and previous session context from SQLite store"
      }
    ]
  }
}
